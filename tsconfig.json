{
  "extends": [
    "@tsconfig/node22/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "lib": ["dom", "ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "source",
    "tests",
    "vitest.config.ts",
    "eslint.config.js",
    "tools",
    "_/amazon/handlers",
    "prettier.config.ts"
  ]
}
